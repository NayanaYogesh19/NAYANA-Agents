# ── Copy this file to .env and fill in your real keys ────────
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env  (Windows)

# ── OpenRouter (AI engine) ────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Google OAuth 2.0 (GA4 connection) ────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# ── Microsoft Clarity (optional) ─────────────────────────────
CLARITY_API_KEY=your-clarity-api-key-here

# ── Accounts spreadsheet path ────────────────────────────────
ACCOUNTS_CSV=data/accounts.csv
