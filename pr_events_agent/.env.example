# Copy this file to .env and fill in the values.
# Only OPENROUTER_API_KEY is required. Every other block is optional —
# if left blank, that integration is skipped (with a log warning),
# it will not crash the run.

# --- Required: OpenRouter (OpenAI-compatible) LLM ----------------------
# Sign up and create a key at: https://openrouter.ai/keys
# OPENROUTER_MODEL uses OpenRouter's "provider/model" naming — this is
# routed to OpenAI's gpt-4o-mini, NOT Anthropic.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: Google Custom Search JSON API ---------------------------
# Free tier: 100 queries/day, then paid. If left blank, discovery still
# works via the free Google News RSS feed (no key needed at all).
# Get keys at: https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Optional: Wayback Machine "Save Page Now" archiving ---------------
# Free Internet Archive account required, no cost. Generate keys at:
# https://archive.org/account/s3.php
# The read-only availability/CDX lookups used elsewhere need NO key at all.
WAYBACK_ACCESS_KEY=
WAYBACK_SECRET_KEY=
ENABLE_ARCHIVING=false

# --- Optional: Google Sheets output -------------------------------------
# Path to a Google service-account JSON key file, and the target sheet's
# ID (the long string in its URL). If blank, a local .xlsx is written
# instead (this always happens regardless, as a guaranteed fallback).
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# --- Optional: Email output ----------------------------------------------
# Works with a Gmail "app password" or any other SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_RECIPIENT=

# --- Behaviour tuning (sensible defaults, rarely need changing) ----------
SEARCH_WINDOW_BUFFER_DAYS=15
MAX_CANDIDATES_PER_CATEGORY=8
REQUEST_TIMEOUT=20
